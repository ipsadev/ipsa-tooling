# `ipsa`'s settings: copy this to `.env` beside it. It is the only env file: the
# CLI reads it, and every `docker compose` it runs on `stack/` inherits it, so
# the contract addresses, ports, chain ids, client ids and images the stack runs
# all live here. Values here override the shell.
# `ipsa` knows no other repository: where releases, images and sources live is
# only ever read from here. Those have no default, so the values below are the
# ones this stack uses. Everything else shows its default; empty ones are either
# required or written by `ipsa` as it runs.

# The stack ships in `stack/` beside this file. Set this only to run a copy of it
# from somewhere else.
IPSA_STACK_DIR=

# Stellar network + deployer key — signs/deploys the soroban contracts
STELLAR_KEY_NAME=stellar-relayer
DEPLOYER_IDENTITY=admin

# Stellar sender/receiver accounts — endpoints of an ICS-20 transfer
STELLAR_SENDER_IDENTITY=stellar-sender
STELLAR_SENDER_ADDRESS=
STELLAR_SENDER_KEY=
STELLAR_RECEIVER_IDENTITY=stellar-receiver
STELLAR_RECEIVER_ADDRESS=
STELLAR_RECEIVER_KEY=

# Stellar api + gateway — the URLs `ipsa` probes and queries
STELLAR_GATEWAY_URL=127.0.0.1:50052

# Local Cosmos devnet (simd-1) — endpoints, relayer/validator keys, accounts
COSMOS_KEY_NAME=relayer
COSMOS_GAS_PRICE=0.025
COSMOS_SENDER_KEY_NAME=cosmos-sender
COSMOS_SENDER_ADDRESS=
COSMOS_RECEIVER_KEY_NAME=cosmos-receiver
COSMOS_RECEIVER_ADDRESS=

# Cosmos testnet (provider) — used when targeting the public chain instead of the devnet
COSMOS_TESTNET_CHAIN_ID=provider
COSMOS_TESTNET_RPC_URL=https://rpc.provider-sentry-01.hub-testnet.polypore.xyz
COSMOS_TESTNET_REST_URL=https://rest.provider-sentry-01.hub-testnet.polypore.xyz
COSMOS_TESTNET_FAUCET_URL=https://faucet.polypore.xyz
COSMOS_TESTNET_GAS_DENOM=uatom
COSMOS_TESTNET_MNEMONIC=
COSMOS_TESTNET_KEY_NAME=ipsa-cosmos
COSMOS_TESTNET_KEYRING_BACKEND=test
COSMOS_TESTNET_RECEIVER_ADDRESS=
COSMOS_TESTNET_GOV_AUTHORITY=cosmos10d07y265gmmuvt4z0w9aw880jnsr700j6zn9kn
# Where the proposal's metadata JSON is published; empty means the light-client
# release asset provider-store-code-metadata.json. The forum link defaults to the release.
COSMOS_PROPOSAL_METADATA=
COSMOS_PROPOSAL_FORUM_URL=

# Deployed Soroban contracts — written by `tx contracts deploy`
GMP_CONTRACT_ADDRESS=
MOCK_LC_CONTRACT_ID=
ATTESTATION_LC_CONTRACT_ID=
TENDERMINT_LC_CONTRACT_ID=

# Router wiring — client types and the ICS-20 port
TRANSFER_PORT=transfer
MOCK_CLIENT_TYPE=mock
ATTESTATION_CLIENT_TYPE=attestation
TENDERMINT_CLIENT_TYPE=07-tendermint

# Releases `ipsa` downloads with gh — the repository (owner/name) and the tag
CONTRACTS_REPOSITORY=ipsadev/ipsa-contracts
CONTRACTS_VERSION=v0.1.0
LIGHT_CLIENT_REPOSITORY=ipsadev/stellar-light-client
LIGHT_CLIENT_VERSION=v0.1.0

# Stellar light client stored on cosmos — a local build to use instead of the release
LIGHT_CLIENT_WASM_DIR=
LIGHT_CLIENT_WASM_CHECKSUM=
PINNED_QUORUM_SET_HASHES=

# api + gateway images — pulled/run by docker compose
API_REGISTRY=
GATEWAY_REGISTRY=

# Relayer image + source (for `services build --relayer`) + its api
RELAYER_REGISTRY=
RELAYER_CONTEXT=../ibc-relayer
RELAYER_REPO_URL=
RELAYER_BRANCH=main

# SCP verifier image + source
VERIFIER_REGISTRY=
VERIFIER_REPO_URL=
VERIFIER_BRANCH=main

# Watcher + postgres images
POSTGRES_IMAGE=postgres:18

# Docker registry credentials — pull/push the private images
DOCKER_USERNAME=
DOCKER_TOKEN=

# Stellar <-> EVM corridor — the live Sepolia values
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_PRIVATE_KEY=
# Signs the relayer's Sepolia transactions; `ipsa` writes it to the relayer's
# keys file. Keep it apart from EVM_PRIVATE_KEY, which deploys and sends.
EVM_RELAYER_PRIVATE_KEY=
EVM_CHAIN_ID=11155111
EVM_ICS26_ROUTER=0x3f09B9D0E8453C91FBA256F8e2A39A7200D7604B
EVM_ICS20_TRANSFER=0x28b94Ea9eb1f91686AcEA5c46A1e9331E51CC7D4
EVM_STELLAR_CLIENT_ID=stellar-testnet-1
EVM_STELLAR_SENDER_IDENTITY=
STELLAR_EVM_CHAIN_ID=
STELLAR_EVM_ROUTER=
STELLAR_EVM_TRANSFER=
STELLAR_EVM_CLIENT_ID=sepolia-0
STELLAR_EVM_CLIENT_TYPE=sepolia
STELLAR_EVM_RELAYER_IDENTITY=
PROOF_API_URL=http://127.0.0.1:3100
# stellar-proof-api runs on the host from its own checkout (ibc-contracts):
# `ipsa proof-api start` runs PROOF_API_BINARY there with PROOF_API_CONFIG and
# the checkout's PROOF_API_ENV_FILE (the SP1 prover keys), relative to it.
PROOF_API_DIR=
PROOF_API_BINARY=target/release/stellar-proof-api
PROOF_API_CONFIG=programs/stellar-proof-api/testnet.json
PROOF_API_ENV_FILE=.env

# ===========================================================================
# What the stack in stack/ reads too. Every `docker compose` call inherits
# this file, so the services see these as their environment.
# ===========================================================================

# Stellar network + deployer key — signs/deploys the soroban contracts
STELLAR_CHAIN_ID=stellar-testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_SIGNING_KEY=
DEPLOYER_ADDRESS=

# Stellar api service — where it binds and the URL the CLI probes
STELLAR_API_HOST=0.0.0.0
STELLAR_API_PORT=8101

# Browser origins allowed to call the api directly (comma separated).
# Unset means no CORS headers at all, which is correct for a server-to-server
# deployment. Never set this to *: the api submits transactions.
STELLAR_API_CORS_ORIGINS=http://localhost:3000
STELLAR_API_URL=http://127.0.0.1:8101

# Stellar gateway gRPC service — where it binds and the URL the CLI queries
STELLAR_GATEWAY_HOST=0.0.0.0
STELLAR_GATEWAY_GRPC_PORT=50052

# Local Cosmos devnet (simd-1) — endpoints, relayer/validator keys, accounts
COSMOS_CHAIN_ID=simd-1
COSMOS_RPC_URL=http://127.0.0.1:26657
COSMOS_REST_URL=http://127.0.0.1:1317
COSMOS_ACCOUNT_PREFIX=cosmos
COSMOS_GAS_DENOM=stake
COSMOS_VALIDATOR_MNEMONIC=
COSMOS_RELAYER_MNEMONIC=
COSMOS_RELAYER_PRIVATE_KEY=
COSMOS_VALIDATOR_PRIVATE_KEY=

# Deployed Soroban contract addresses — written by `tx contracts deploy`
ROUTER_CONTRACT_ADDRESS=
TRANSFER_CONTRACT_ADDRESS=

# api container image — pulled/run by docker compose
API_IMAGE=amandagonsalvesx/ipsa-api
API_TAG=latest

# gateway container image — pulled/run by docker compose
GATEWAY_IMAGE=amandagonsalvesx/ipsa-gateway
GATEWAY_TAG=latest

# --- IBC v2 relaying stack (docker compose profile: ibcv2) -------------------
WATCHER_NETWORK=testnet
WATCHER_IMAGE=stellar/stellar-core
WATCHER_TAG=latest
WATCHER_HTTP_PORT=11626
STELLAR_WATCHER_DB=/watcher/stellar-misc.db

RELAYER_IMAGE=amandagonsalvesx/ipsa-relayer
RELAYER_TAG=latest
RELAYER_API_PORT=9001
RELAYER_METRICS_PORT=48001
# Where ipsa-api dials the relayer's RelayerApiService for `tx relay`.
# Inside compose this is the service name; use 127.0.0.1 when running api locally.
RELAYER_API_URL=http://relayer:9001

POSTGRES_USER=relayer
POSTGRES_PASSWORD=relayer
POSTGRES_DB=relayer
POSTGRES_PORT=42500

VERIFIER_IMAGE=amandagonsalvesx/ipsa-scp-verifier
VERIFIER_TAG=latest
VERIFIER_PORT=8110
VERIFIER_NETWORK=mainnet
VERIFIER_CORS_ORIGINS=

COSMOS_RELAYER_ADDRESS=

ROUTER_GENESIS_LEDGER=
